<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ScrollPane?>

<StackPane stylesheets="@style.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.FormController">

    <!-- FONDO: degradado cielo estrellado -->
    <Region mouseTransparent="true"
            style="-fx-background-color: linear-gradient(to bottom, #0a0a1a, #0d1b3e, #1a1a4e, #0a0a2a);"/>

    <!-- Contenido con scroll -->
    <ScrollPane fitToWidth="true" styleClass="form-scroll"
                style="-fx-background: transparent; -fx-background-color: transparent;">

        <VBox styleClass="form-content" spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <Label fx:id="lblTituloFormulario" text="Añadir Nuevo Juego" styleClass="title-label"/>

            <GridPane vgap="15" hgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Título -->
                <Label text="Título:" styleClass="text-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTitulo" promptText="Ej: RNG Slime"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Desarrolladora -->
                <Label text="Desarrollo:" styleClass="text-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDesarrolladora" promptText="Ej: KoalaStudios"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Año -->
                <Label text="Año:" styleClass="text-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtAnio" promptText="Ej: 2026"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Descripción -->
                <Label text="Descripción:" styleClass="text-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextArea fx:id="txtDescripcion" promptText="Describe el juego..."
                          prefHeight="80" wrapText="true"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Rating -->
                <Label text="Rating (0-5):" styleClass="text-label"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtRating" promptText="Ej: 4.5"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Plataformas -->
                <Label text="Plataformas:" styleClass="text-label"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <ListView fx:id="listPlataformas" prefHeight="120"
                          GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <!-- Géneros -->
                <Label text="Géneros:" styleClass="text-label"
                       GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ListView fx:id="listGeneros" prefHeight="120"
                          GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <!-- Portada -->
                <Label text="Portada:" styleClass="text-label"
                       GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <HBox spacing="10" alignment="CENTER_LEFT"
                      GridPane.rowIndex="7" GridPane.columnIndex="1">
                    <VBox spacing="5">
                        <Button text="Seleccionar imagen"
                                onAction="#seleccionarImagen"
                                styleClass="btn-secondary"/>
                        <Label fx:id="lblRutaImagen" text="Sin imagen" styleClass="text-label"/>
                    </VBox>
                    <ImageView fx:id="imgPortadaPreview"
                               fitWidth="80" fitHeight="100"
                               preserveRatio="true" smooth="true"/>
                </HBox>
            </GridPane>

            <!-- Botones -->
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Cancelar" onAction="#cancelar" styleClass="btn-secondary"/>
                <Button fx:id="btnGuardar" text="Guardar Juego" onAction="#guardar" styleClass="btn-success"/>
            </HBox>

        </VBox>
    </ScrollPane>

</StackPane>