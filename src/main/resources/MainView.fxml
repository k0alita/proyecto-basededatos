<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.ImageView?>

<BorderPane stylesheets="@style.css" styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MainController">

    <!-- PARTE SUPERIOR: Título y Buscador -->
    <top>
        <VBox spacing="15" styleClass="header-section">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="RobloxGames - Gestor de Videojuegos de Roblox" styleClass="title-label"/>

            <!-- Buscador obligatorio de 2 campos -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Buscar:" styleClass="text-label"/>
                <TextField fx:id="txtBuscarTitulo" promptText="Título del juego..." prefWidth="200"/>
                <ComboBox fx:id="comboBuscarPlataforma" promptText="Plataforma..." prefWidth="150"/>
                <Button text="Filtrar" onAction="#filtrarJuegos" styleClass="btn-primary"/>
                <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <!-- PARTE CENTRAL: Listado de Juegos + Portada -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="0" right="20" bottom="10" left="20"/>
            </padding>

            <!-- Tabla de juegos -->
            <TableView fx:id="tablaJuegos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colTitulo" text="Título" prefWidth="250"/>
                    <TableColumn fx:id="colDesarrolladora" text="Desarrolladora" prefWidth="180"/>
                    <TableColumn fx:id="colAnio" text="Año" prefWidth="70"/>
                    <TableColumn fx:id="colPlataforma" text="Plataforma" prefWidth="120"/>
                    <TableColumn fx:id="colGeneros" text="Géneros" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Portada del juego seleccionado -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Portada del juego seleccionado:" styleClass="text-label"/>
                <ImageView fx:id="imgPortadaMain"
                           fitWidth="120"
                           fitHeight="160"
                           preserveRatio="true"
                           smooth="true"/>
            </HBox>
        </VBox>
    </center>

    <!-- PARTE INFERIOR: Botones de Acción -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="footer-section">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button text="Añadir Juego" onAction="#abrirFormularioAlta" styleClass="btn-success"/>
            <Button text="Eliminar Juego" onAction="#eliminarJuego" styleClass="btn-danger"/>
        </HBox>
    </bottom>

</BorderPane>