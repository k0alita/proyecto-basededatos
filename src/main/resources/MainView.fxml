<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>

<BorderPane stylesheets="@style.css" styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MainController">

    <!-- TOP: Título + buscador -->
    <top>
        <VBox spacing="10" styleClass="header-section">
            <padding>
                <Insets top="0" right="0" bottom="15" left="0"/>
            </padding>

            <!-- Barra de título personalizada -->
            <HBox spacing="10"
                  alignment="CENTER"
                  styleClass="title-bar"
                  onMousePressed="#onTitleBarPressed"
                  onMouseDragged="#onTitleBarDragged">
                <padding>
                    <Insets top="6" right="12" bottom="6" left="12"/>
                </padding>

                <!-- Espaciador izquierda -->
                <Region prefWidth="10"/>

                <!-- Título centrado -->
                <Label text="RobloxGames - Gestor de Videojuegos de Roblox"
                       styleClass="title-label"/>

                <!-- Espaciador flexible + botones derecha -->
                <HBox spacing="6" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="—" onAction="#minimizarVentana" styleClass="btn-titlebar"/>
                    <Button text="✕" onAction="#cerrarVentana" styleClass="btn-titlebar-cerrar"/>
                </HBox>
            </HBox>

            <!-- Buscador y botón Editar -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="header-section-inner">
                <padding>
                    <Insets top="10" right="20" bottom="10" left="20"/>
                </padding>

                <Label text="Buscar:" styleClass="text-label"/>
                <TextField fx:id="txtBuscarTitulo" promptText="Título del juego..." prefWidth="240"/>
                <ComboBox fx:id="comboBuscarPlataforma" promptText="Plataforma..." prefWidth="180"/>

                <!-- Botón Editar al lado de los campos de búsqueda -->
                <Button text="Editar Juego" onAction="#abrirFormularioEdicion" styleClass="btn-primary"/>

                <!-- Region expansible para empujar contenido si lo hubiera a la derecha -->
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: Tabla + ficha -->
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="0" right="30" bottom="10" left="30"/>
            </padding>

            <!-- Tabla de juegos (ocupa la mayor parte del ancho) -->
            <TableView fx:id="tablaJuegos" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="45"/>
                    <TableColumn fx:id="colPortada" text="Portada" prefWidth="60"/>
                    <TableColumn fx:id="colTitulo" text="Título" prefWidth="360"/>
                    <TableColumn fx:id="colDesarrolladora" text="Desarrolladora" prefWidth="260"/>
                    <TableColumn fx:id="colAnio" text="Año" prefWidth="70"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Ficha del juego seleccionado -->
            <VBox fx:id="panelDetalle" spacing="10" prefWidth="260" maxWidth="260">
                <Label text="Detalles del juego" styleClass="text-label"/>

                <ImageView fx:id="imgPortadaMain"
                           fitWidth="220"
                           fitHeight="300"
                           preserveRatio="true"
                           smooth="true"/>

                <Label fx:id="lblDetalleTitulo" styleClass="text-label" text="Título: -"/>
                <Label fx:id="lblDetalleDesarrolladora" styleClass="text-label" text="Desarrolladora: -"/>
                <Label fx:id="lblDetalleAnio" styleClass="text-label" text="Año: -"/>
                <Label fx:id="lblDetallePlataformas" styleClass="text-label" text="Plataformas: -"/>
                <Label fx:id="lblDetalleGeneros" styleClass="text-label" text="Géneros: -"/>
            </VBox>
        </HBox>
    </center>

    <!-- BOTTOM: Botones de Acción (Añadir y Eliminar) -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="footer-section">
            <padding>
                <Insets top="10" right="30" bottom="20" left="30"/>
            </padding>
            <Button text="Añadir Juego" onAction="#abrirFormularioAlta" styleClass="btn-success"/>
            <Button text="Eliminar Juego" onAction="#eliminarJuego" styleClass="btn-danger"/>
        </HBox>
    </bottom>

</BorderPane>